# 총무해방 서버 설정 (복사: cp .env.example .env)
# .env 는 git 에 올라가지 않습니다. 값을 문서·대화·화면에 올리지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# low | medium | high
OPENAI_REASONING=low
# 주문 분석(취소·변경 반영)용 추론 강도. 기본 medium
# ORDER_REASONING=medium
# 게이트웨이/프록시를 쓸 때만
# OPENAI_BASE_URL=
PORT=8080
AI_RATE_PER_MIN=20
AI_TIMEOUT_MS=60000
